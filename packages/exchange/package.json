{
  "name": "@julong/mono-rele2-exchange",
  "version": "1.39.0",
  "description": "Use this skill to fetch the latest KRW exchange rates for China, Japan, and the Euro area from Naver, Google, and Daum via the mono-rele2-exchange CLI. Scrapes each portal with Playwright and returns JSON, using null for any rate it cannot read.",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "mono-rele2-exchange": "./dist/server.js",
    "mono-rele2-exchange-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "lint": "rslint --config ../../rslint.config.ts .",
    "format": "prettier --write src/ --write '*.{ts,json,js}'",
    "format:check": "prettier --check src/ --check '*.{ts,json,js}'",
    "readme": "bun ../common/build/update-readme.mjs",
    "test:agent": "pnpm -w run test:agent"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.2"
  }
}
