# TMDB (영화 도구 — movies_now_playing / movies_upcoming / movie_recommendations)
# 둘 중 하나만 채우면 됩니다. https://www.themoviedb.org/settings/api 에서 발급합니다.
TMDB_API_KEY=<your-tmdb-v3-api-key>
# TMDB_ACCESS_TOKEN=<your-tmdb-read-access-token>

# LLM (OpenAI 호환 엔드포인트 — 예: SiliconFlow)
# src/common/agent 의 createChatModel()이 읽습니다.
SILICONFLOW_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-8B
OPENAI_API_KEY=<your-api-key>
